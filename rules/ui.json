[
  {
    "id": "ui.show-file-extensions",
    "name": "Mostrar extensiones de archivos",
    "description": "Obliga al Explorador de Archivos a mostrar la extensión de todos los archivos conocidos.",
    "category": "ui",
    "risk": "low",
    "presets": [
      "minimal",
      "standard",
      "advanced"
    ],
    "windows": {
      "min_build": 10240,
      "editions": [
        "Home",
        "Pro",
        "Enterprise",
        "Education"
      ]
    },
    "detect": {
      "registry": {
        "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "HideFileExt",
        "expected_value": 0
      }
    },
    "apply": [
      {
        "type": "registry_set",
        "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "HideFileExt",
        "value": 0,
        "kind": "DWord"
      }
    ],
    "undo": "auto_from_snapshot",
    "reversible": true,
    "requires_admin": false,
    "requires_reboot": false,
    "explain": {
      "what": "Windows oculta por defecto las extensiones de los archivos (.exe, .txt, .jpg).",
      "why": "Ver la extensión real previene la ejecución de malware camuflado (por ejemplo, 'documento.pdf.exe').",
      "changes": "Cambia HideFileExt a 0 en HKCU."
    },
    "impact": {
      "type": "security",
      "estimator": "none",
      "confidence": "high",
      "show_percentage": false
    },
    "sources": [
      "WinUtil: File Explorer File Extensions"
    ]
  },
