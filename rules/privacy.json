  {
    "id": "privacy.disable-advertising-id",
    "name": "Desactivar ID de publicidad del usuario",
    "description": "Impide que Windows use un identificador único para mostrarte publicidad personalizada en tu cuenta de usuario.",
    "category": "privacy",
    "risk": "low",
    "presets": [
      "minimal",
      "standard",
      "advanced"
    ],
    "windows": {
