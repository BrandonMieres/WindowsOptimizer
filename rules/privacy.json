      "editions": [
        "Home",
        "Pro",
        "Enterprise",
        "Education"
      ]
    },
    "detect": {
      "registry": {
        "path": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
        "name": "Enabled",
        "bad_value": 1
      }
    },
    "apply": [
      {
        "type": "registry_set",
        "path": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
        "name": "Enabled",
        "value": 0,
        "kind": "DWord"
      }
    ],
    "undo": "auto_from_snapshot",
    "reversible": true,
    "requires_admin": false,
    "requires_reboot": false,
    "explain": {
