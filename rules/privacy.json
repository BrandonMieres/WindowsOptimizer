      "why": "Desactivarlo reduce drásticamente el rastreo publicitario sin afectar al funcionamiento del sistema.",
      "changes": "Establece la clave de registro HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo\\Enabled en 0."
    },
    "impact": {
      "type": "privacy",
      "estimator": "none",
      "confidence": "high",
      "show_percentage": false
    },
    "sources": [
