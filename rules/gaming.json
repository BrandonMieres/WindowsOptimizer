        "id": "gaming.powerplan-high-performance",
        "name": "Activar Plan de Alto o Máximo Rendimiento",
        "description": "Configura el plan de energía activo en 'Alto rendimiento' o 'Máximo rendimiento' para reducir latencia de CPU y evitar throttling.",
        "category": "gaming",
        "risk": "low",
        "presets": [
            "standard",
            "advanced"
        ],
        "windows": {
            "min_build": 10240,
            "editions": [
                "Home",
                "Pro",
                "Enterprise",
                "Education"
            ]
        },
        "detect": {
            "power_plan": {
                "expected_schemes": [
