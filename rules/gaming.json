        "requires_admin": false,
        "requires_reboot": false,
        "explain": {
            "what": "Windows utiliza por defecto el plan 'Equilibrado', reduciendo frecuencias y durmiendo núcleos cuando la carga baja.",
            "why": "En gaming, los saltos de frecuencia causan micro-tirones (frametime spikes) y aumentan la latencia del procesador.",
            "changes": "Cambia el plan de energía activo al de Máximo Rendimiento (o Alto Rendimiento)."
        },
        "impact": {
            "type": "performance",
            "estimator": "none",
            "confidence": "high",
