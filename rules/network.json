                                        "expected_value":  1
                                    }
                   },
        "apply":  [
                      {
                          "type":  "registry_set",
                          "path":  "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters",
                          "name":  "TcpNoDelay",
                          "value":  1,
                          "kind":  "DWord"
                      }
                  ],
        "undo":  "auto_from_snapshot",
        "reversible":  true,
        "requires_admin":  true,
        "requires_reboot":  true,
        "explain":  {
                        "what":  "El algoritmo de Nagle agrupa paquetes TCP pequeños para enviarlos juntos, añadiendo latencia.",
                        "why":  "Desactivarlo reduce la latencia en aplicaciones interactivas (juegos, escritorio remoto, etc.).",
                        "changes":  "Establece TcpNoDelay a 1 en los parámetros TCP/IP."
                    },
        "impact":  {
                       "type":  "performance",
                       "confidence":  "medium",
                       "show_percentage":  false
                   },
        "sources":  [
                        "CATALOGO_OPTIMIZACIONES.md §4"
                    ]
    },
