[
    {
        "id":  "network.set-dns-cloudflare",
        "name":  "Optimizar DNS (Cloudflare)",
        "description":  "Configura el DNS primario a Cloudflare (1.1.1.1) para mejorar la resolución de nombres.",
        "category":  "network",
        "risk":  "low",
        "presets":  [
                        "standard",
                        "advanced"
                    ],
        "detect":  {
                       "registry":  {
                                        "path":  "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Dnscache\\Parameters",
                                        "name":  "MaxCacheTtl",
                                        "expected_value":  86400
                                    }
                   },
        "apply":  [
                      {
                          "type":  "registry_set",
                          "path":  "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Dnscache\\Parameters",
                          "name":  "MaxCacheTtl",
                          "value":  86400,
                          "kind":  "DWord"
                      }
                  ],
        "undo":  "auto_from_snapshot",
        "reversible":  true,
        "requires_admin":  true,
        "requires_reboot":  false,
        "explain":  {
                        "what":  "El caché DNS de Windows tiene un TTL máximo limitado. Aumentarlo reduce las consultas DNS repetidas.",
                        "why":  "Reduce la latencia de resolución DNS al mantener las respuestas en caché más tiempo.",
                        "changes":  "Establece MaxCacheTtl a 86400 segundos (24 horas) en los parámetros del servicio DNS."
                    },
        "impact":  {
                       "type":  "performance",
                       "confidence":  "medium",
                       "show_percentage":  false
                   },
        "sources":  [
                        "CATALOGO_OPTIMIZACIONES.md §4"
                    ]
    },
