<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsOptimizer_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsOptimizer_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Optimizer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            Title="Windows Optimizer"
            Subtitle="v1.0 · Analiza · Optimiza · Protege">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <!-- Shell de navegación principal -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="Left"
            OpenPaneLength="260">
            <NavigationView.MenuItems>
                <!-- Accesos Principales -->
                <NavigationViewItem
                    x:Name="NavDashboard"
                    Content="Dashboard"
                    Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavLiveDiagnostic"
                    Content="¿Por qué va lento?"
                    Tag="LiveDiagnostic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- Categoría 1: Rendimiento y Gaming -->
                <NavigationViewItem
                    Content="Rendimiento y Gaming"
                    Tag="Cat_Performance"
                    SelectsOnInvoked="False"
                    IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            Content="Rendimiento"
                            Tag="Performance">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Gaming"
                            Tag="Gaming">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Arranque"
                            Tag="Startup">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Servicios"
                            Tag="Services">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE912;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Categoría 2: Limpieza y Espacio -->
                <NavigationViewItem
                    Content="Limpieza y Espacio"
                    Tag="Cat_Cleanup"
                    SelectsOnInvoked="False"
                    IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            Content="Limpieza de Archivos"
                            Tag="Cleaners">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Analizador de Disco"
                            Tag="Disk">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEDA2;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Apps (Bloatware)"
                            Tag="Apps">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE718;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Categoría 3: Sistema y Configuración -->
                <NavigationViewItem
                    Content="Sistema y Ajustes"
                    Tag="Cat_System"
                    SelectsOnInvoked="False"
                    IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            Content="Ajustes de Windows"
                            Tag="SystemTweaks">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Personalización UI"
                            Tag="Ui">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE790;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Privacidad y Telemetría"
                            Tag="Privacy">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE72E;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Red y Conectividad"
                            Tag="Network">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE968;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Categoría 4: Hardware y Diagnóstico -->
                <NavigationViewItem
                    Content="Hardware y Diagnóstico"
                    Tag="Cat_Hardware"
                    SelectsOnInvoked="False"
                    IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            Content="Información del Sistema"
                            Tag="SystemInfo">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE770;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Drivers y Dispositivos"
                            Tag="Drivers">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7F8;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- Historial -->
                <NavigationViewItem
                    Content="Historial y Rollback"
                    Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Contenido principal: Frame para navegación entre páginas -->
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
        <!-- Toast de Notificacion Flotante (Abajo a la Derecha) -->
        <Border x:Name="NotificationToast"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                MinWidth="320"
                MaxWidth="400"
                CornerRadius="12"
                Padding="16,14"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Shadow="{StaticResource SharedShadow}"
                Translation="0,0,32"
                Visibility="Collapsed"
                Canvas.ZIndex="9999">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icono de estado: Progreso -->
                <ProgressRing x:Name="ToastProgressRing"
                              Grid.Column="0"
                              Width="22"
                              Height="22"
                              IsActive="True"
                              VerticalAlignment="Center" />

                <!-- Icono de estado: Exito -->
                <Border x:Name="ToastSuccessBadge"
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        CornerRadius="13"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;"
                              FontSize="13"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Icono de estado: Error -->
                <Border x:Name="ToastErrorBadge"
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        CornerRadius="13"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <FontIcon Glyph="&#xE783;"
                              FontSize="13"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Textos -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="ToastTitle"
                               Text="Aplicando optimizaciones..."
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock x:Name="ToastMessage"
                               Text="Modificando ajustes del sistema..."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Boton Cerrar -->
                <Button Grid.Column="2"
                        Padding="6"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseToast_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>

