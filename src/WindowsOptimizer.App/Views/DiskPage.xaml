    <Page
    x:Class="WindowsOptimizer_App.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsOptimizer.Core.Models"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Background="Transparent">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Analizador de Disco" 
                           Style="{StaticResource TitleTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Encuentra archivos temporales y basura acumulada para liberar espacio en tu disco duro." 
                           Style="{StaticResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.CleanJunkCommand}"
                        Style="{StaticResource PremiumButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        <TextBlock Text="Limpiar Basura" />
                    </StackPanel>
                </Button>
                
                <Button Command="{x:Bind ViewModel.ScanCommonJunkCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="Escanear Basura Común"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{x:Bind ViewModel.ScanCDriveCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDA2;" FontSize="14"/>
                        <TextBlock Text="Escanear C: Completo"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.CancelScanCommand}"
                        Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="Red"/>
                        <TextBlock Text="Cancelar" Foreground="Red"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra de progreso general -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ProgressBar IsIndeterminate="True" 
                             Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                             Height="4" CornerRadius="2"/>
            </StackPanel>
        </Grid>

        <!-- Árbol de carpetas estilo TreeSize -->
        <Grid Grid.Row="2">
        <TreeView x:Name="DiskTreeView"
                  ItemsSource="{x:Bind ViewModel.TopFolders}"
                  SelectionMode="None"
                  ItemInvoked="DiskTreeView_ItemInvoked">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="models:DiskNode">
                    <TreeViewItem ItemsSource="{x:Bind Children}">
                        <Grid Padding="4,8,4,8" MinHeight="40" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Borrar" Icon="Delete" Click="DeleteFolder_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource SystemAccentColorLight2}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind FullPath}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Maximum="1" Value="{x:Bind PercentageOfParent, Mode=OneWay}" Height="6" CornerRadius="3" Margin="0,2,0,0" Foreground="{ThemeResource SystemAccentColor}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

            <!-- Estado Vacío -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <FontIcon Glyph="&#xEDA2;" FontSize="64" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                <TextBlock Text="Inicia un escaneo para analizar tu disco" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
