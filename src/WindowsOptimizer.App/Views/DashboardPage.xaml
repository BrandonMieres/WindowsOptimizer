<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsOptimizer_App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsOptimizer.Core.Models"
    xmlns:converters="using:WindowsOptimizer_App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    </Page.Resources>

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="24">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.Transitions>

            <!-- Encabezado -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Dashboard" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Resumen del estado de tu equipo." />
                </StackPanel>

                <!-- Nivel de análisis -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Nivel de análisis:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        x:Name="PresetComboBox"
                        ItemsSource="{x:Bind ViewModel.AvailablePresets}"
                        SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                        MinWidth="300"
                        SelectionChanged="PresetComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono por nivel -->
                                    <FontIcon
                                        x:Name="PresetIcon"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalAlignment="Center"
                                        Glyph="{Binding Icon}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                    <!-- Nombre + subtexto -->
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <Border 
                                                Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                                                CornerRadius="4" 
                                                Padding="6,1" 
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Badge, Converter={StaticResource NullToCollapsedConverter}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Info del nivel seleccionado -->
            <Border
                x:Name="PresetInfoBar"
                Style="{StaticResource PremiumCardStyle}"
                Padding="14,10"
                Opacity="0.9">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="PresetInfoIcon"
                        FontSize="18"
                        VerticalAlignment="Center"
                        Glyph="&#xE946;"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="PresetInfoText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Análisis equilibrado con las optimizaciones recomendadas para la mayoría de usuarios." />
                    <Border
                        x:Name="PresetBadge"
                        Grid.Column="2"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12">
                        <TextBlock
                            x:Name="PresetBadgeText"
                            Text="✓ Recomendado"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Tarjeta de puntuación de salud -->
            <Border
                Style="{StaticResource PremiumCardStyle}"
                Shadow="{StaticResource SharedShadow}"
                Translation="0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Puntuación circular -->
                    <Grid
                        Width="120"
                        Height="120"
                        Margin="0,0,32,0">
                        <ProgressRing
                            x:Name="HealthRing"
                            Width="120"
                            Height="120"
                            IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.HealthScore, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="HealthScoreText"
                                HorizontalAlignment="Center"
                                FontSize="36"
                                FontWeight="Bold"
                                Text="{x:Bind ViewModel.HealthScore, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="de 100" />
                        </StackPanel>
                    </Grid>

                    <!-- Descripción -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" />
                        
                        <!-- Badges de Línea Base en Vivo -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Inicio / Uptime -->
                            <Border Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE823;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inicio: " />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="{x:Bind ViewModel.BootTimeDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE950;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="RAM: " />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="{x:Bind ViewModel.RamUsageDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Procesos -->
                            <Border Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE9D9;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Procesos: " />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="{x:Bind ViewModel.ProcessCountDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón analizar -->
                    <Button
                        x:Name="ScanButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ScanCommand}"
                        Style="{StaticResource PremiumAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                            <TextBlock Text="Analizar" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Banner de Estimación de Impacto -->
            <Border
                Visibility="{x:Bind ViewModel.HasEstimatedImpact, Mode=OneWay}"
                Style="{StaticResource PremiumCardStyle}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                Padding="16,12">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        FontSize="22"
                        VerticalAlignment="Center"
                        Glyph="&#xE9D9;"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Impacto estimado antes de optimizar" />
                            <Border
                                Padding="6,1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    Text="Estimación orientativa"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ImpactSummaryDisplay, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resumen por categoría -->
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Resumen por categoría" />

            <ItemsRepeater x:Name="CategoryCards">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="3"
                        MinColumnSpacing="12"
                        MinItemWidth="200"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource PremiumCardStyle}"
                            Shadow="{StaticResource SharedShadow}"
                            Translation="0,0,8"
                            Margin="4">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="{Binding Icon}" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding Count}" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="hallazgos" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Status}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Hallazgos encontrados (integrados tras el escaneo) -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel
                x:Name="FindingsSection"
                Spacing="16"
                Visibility="Collapsed">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.Transitions>

                <!-- Cabecera de hallazgos con botón Optimizar Todo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Hallazgos encontrados" />
                        <TextBlock
                            x:Name="FindingsCountText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="RevertAllButton"
                            Command="{x:Bind ViewModel.RevertAllCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE7A7;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="Revertir Todo" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OptimizeAllButton"
                            Style="{StaticResource PremiumAccentButtonStyle}"
                            Command="{x:Bind ViewModel.ApplyPresetCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74C;" />
                                <TextBlock Text="Optimizar Preset Actual" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Contadores rápidos -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Padding="12,6" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock x:Name="DetectedCountText" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DriftedCounterBorder" Padding="12,6" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7A7;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="DriftedCountText" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE930;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="OptimalCountText" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lista de hallazgos -->
                <ItemsRepeater x:Name="FindingsList" ItemsSource="{x:Bind ViewModel.RecentFindings, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Finding">
                            <Border
                                DataContext="{x:Bind}"
                                Style="{StaticResource PremiumCardStyle}"
                                Shadow="{StaticResource SharedShadow}"
                                Translation="0,0,8"
                                Padding="16"
                                Margin="4"
                                BorderBrush="{x:Bind converters:SelectionConverter.GetBrush(IsSelected), Mode=OneWay}"
                                BorderThickness="2.5"
                                Tapped="FindingCard_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Indicador de severidad -->
                                    <Border
                                        Grid.Column="0"
                                        Width="4"
                                        Height="40"
                                        Margin="0,0,16,0"
                                        Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}, Mode=OneWay}"
                                        CornerRadius="2" />

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <Border Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Category}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap"
                                            Text="{x:Bind Description}" />
                                        <!-- Detalle de lo que se modifica o desactiva -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                TextWrapping="Wrap"
                                                Text="{x:Bind Explanation.Changes}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Badge de estado -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Status}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
