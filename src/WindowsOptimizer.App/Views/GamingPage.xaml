<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsOptimizer_App.Views.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsOptimizer.Core.Models"
    xmlns:localmodels="using:WindowsOptimizer_App.Models"
    xmlns:converters="using:WindowsOptimizer_App.Converters"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="36,24,36,24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Tweaks.CategoryName}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.Tweaks.StatusMessage, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.Tweaks.AvailablePresets}"
                    SelectedItem="{x:Bind ViewModel.Tweaks.SelectedPresetItem, Mode=TwoWay}"
                    MinWidth="150"
                    VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="localmodels:PresetItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="{x:Bind Icon}" />
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{x:Bind ViewModel.Tweaks.ScanCommand}" Style="{StaticResource PremiumButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                        <TextBlock Text="Escanear" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.Tweaks.ApplyAllCommand}" Style="{StaticResource PremiumAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Aplicar seleccionados" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Border Padding="12,8" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock><Run Text="{x:Bind ViewModel.Tweaks.DetectedCount, Mode=OneWay}" /><Run Text=" pendientes" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="12,8" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock><Run Text="{x:Bind ViewModel.Tweaks.AppliedCount, Mode=OneWay}" /><Run Text=" aplicados" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE930;" />
                    <TextBlock><Run Text="{x:Bind ViewModel.Tweaks.OptimalCount, Mode=OneWay}" /><Run Text=" ya óptimos" /></TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Power Plans -->
        <Border Grid.Row="2" Margin="0,0,0,24" Style="{StaticResource PremiumCardStyle}" Padding="20">
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="18" Glyph="&#xE7E8;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Planes de Energía de Windows" />
                        </StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Selecciona un plan de energía para optimizar la latencia y desbloquear el máximo rendimiento de tu procesador." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.CreateUltimatePerformanceCommand}" Style="{StaticResource PremiumAccentButtonStyle}" ToolTipService.ToolTip="Habilita y activa el plan oculto de Máximo Rendimiento de Microsoft para estaciones de trabajo.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                                <TextBlock Text="Activar Máximo Rendimiento" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PowerPlans, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="localmodels:PowerPlanItem">
                                <Button Click="PowerPlan_Click" Tag="{x:Bind}"
                                        Padding="14" MinWidth="220" MaxWidth="280"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        BorderThickness="2" BorderBrush="{x:Bind converters:SelectionConverter.GetBrush(IsActive), Mode=OneWay}"
                                        CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon, Badge and Active Indicator -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource SubtleFillColorTertiaryBrush}" Margin="0,0,8,0">
                                                <FontIcon FontSize="14" Glyph="{x:Bind IconGlyph}" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="6,2" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="4">
                                                <TextBlock Text="{x:Bind BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <!-- Active Checkmark -->
                                            <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="11" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="ACTIVO" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Name -->
                                        <TextBlock Grid.Row="1" FontWeight="SemiBold" FontSize="14" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />

                                        <!-- Description & Actions -->
                                        <Grid Grid.Row="2">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Text="{x:Bind Guid}" FontFamily="Consolas" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center" />
                                            <Button Click="DeletePlan_Click" Tag="{x:Bind}" HorizontalAlignment="Right" Padding="4" Background="Transparent" BorderThickness="0"
                                                    Visibility="{x:Bind IsBuiltIn, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="Eliminar plan duplicado">
                                                <FontIcon FontSize="12" Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Tweaks List -->
        <ScrollViewer Grid.Row="3" x:Name="RootGrid">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tweaks.Findings, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Finding">
                        <Border
                            DataContext="{x:Bind}"
                            Style="{StaticResource PremiumCardStyle}"
                            Shadow="{StaticResource SharedShadow}"
                            Translation="0,0,8"
                            Padding="16"
                            Margin="4"
                            BorderBrush="{x:Bind converters:SelectionConverter.GetBrush(IsSelected), Mode=OneWay}"
                            BorderThickness="2.5"
                            Tapped="FindingCard_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Margin="0,0,16,0" Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}, Mode=OneWay}" CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <Border Padding="6,2" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="4"><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Status}" /></Border>
                                    </StackPanel>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind Description}" />
                                    <StackPanel Spacing="2" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run FontWeight="SemiBold" Text="¿Por qué? " /><Run Text="{x:Bind Explanation.Why}" /></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
