<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsOptimizer_App.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsOptimizer.Core.Models"
    xmlns:converters="using:WindowsOptimizer_App.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="20">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.Transitions>

            <!-- Encabezado -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Drivers y Dispositivos" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Auditoría de salud de hardware, detección de fallos de dispositivos y catálogo de controladores." />
                </StackPanel>

                <!-- Botones de Acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Command="{x:Bind ViewModel.OpenDeviceManagerCommand}"
                        ToolTipService.ToolTip="Abre la consola de administración de hardware nativa de Windows (devmgmt.msc)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7F8;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Administrador de Dispositivos" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.ScanCommand}"
                        Style="{StaticResource PremiumAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Volver a Analizar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Banner de Progreso mientras escanea -->
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />

            <!-- Banner de Estado: Dispositivos con problemas detectados -->
            <Border
                Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}"
                Style="{StaticResource PremiumCardStyle}"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="1.5"
                Padding="16,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        FontSize="26"
                        VerticalAlignment="Center"
                        Glyph="&#xE7BA;"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="Dispositivos con fallos o falta de controladores" />
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Summary.SummaryDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Banner de Estado Óptimo: Sin problemas -->
            <Border
                Visibility="{x:Bind ViewModel.HasNoProblems, Mode=OneWay}"
                Style="{StaticResource PremiumCardStyle}"
                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                BorderThickness="1"
                Padding="16,12">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        FontSize="24"
                        VerticalAlignment="Center"
                        Glyph="&#xE930;"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Hardware funcionando correctamente" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Summary.SummaryDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tarjetas de Dispositivos con Error (si existen) -->
            <StackPanel
                Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}"
                Spacing="12">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Dispositivos que requieren atención" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Problems, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceProblem">
                            <Border
                                Style="{StaticResource PremiumCardStyle}"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                BorderThickness="1"
                                Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                        <FontIcon
                                            FontSize="18"
                                            Glyph="&#xE7BA;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <Border Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ClassName}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ErrorDescription}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Suggestion}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Código de Error Badge -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontWeight="Bold"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind ErrorCode, Mode=OneTime}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Sección: Catálogo de Controladores Instalados -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Controladores Instalados" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Lista de drivers verificados y firmados en este equipo." />
                </StackPanel>

                <!-- Barra de búsqueda y filtro -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox
                        Width="220"
                        PlaceholderText="Buscar controlador o fabricante..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                        MinWidth="150">
                        <ComboBoxItem Content="Todos" />
                        <ComboBoxItem Content="Genéricos (Microsoft)" />
                        <ComboBoxItem Content="Antiguos (> 4 años)" />
                        <ComboBoxItem Content="Sin firma digital" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Lista de Controladores -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredDrivers, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:DriverItem">
                        <Border
                            Style="{StaticResource PremiumCardStyle}"
                            Padding="14,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Dispositivo y Fabricante -->
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DeviceName}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind DriverProvider}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="&#x2022;" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind DeviceClass}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Versión -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Versión" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind DriverVersion}" />
                                </StackPanel>

                                <!-- Fecha -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Fecha" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind DriverDate, Mode=OneTime}" />
                                </StackPanel>

                                <!-- Badge de Estado -->
                                <Border
                                    Grid.Column="3"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind StatusText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
