<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsOptimizer_App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsOptimizer.Core.Models"
    xmlns:converters="using:WindowsOptimizer_App.Converters"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="36,24,36,24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Historial de cambios" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.LoadHistoryCommand}" Style="{StaticResource PremiumButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Actualizar" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RevertAllCommand}" Style="{StaticResource PremiumAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                        <TextBlock Text="Revertir todo" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Progreso -->
        <ProgressBar
            Grid.Row="0"
            VerticalAlignment="Bottom"
            IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!-- Lista de cambios -->
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:ChangeRecord">
                        <Border
                            Style="{StaticResource PremiumCardStyle}"
                            Shadow="{StaticResource SharedShadow}"
                            Translation="0,0,8"
                            Padding="16"
                            Margin="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Indicador de estado -->
                                <FontIcon
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Glyph="&#xE73E;"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="Target: " />
                                            <Run Text="{x:Bind Target}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="Original: " />
                                            <Run Text="{x:Bind OriginalValue}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="→ " />
                                            <Run Text="{x:Bind AppliedValue}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Acción de revertir -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Revertido" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                               VerticalAlignment="Center" 
                                               Visibility="{x:Bind IsReverted, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button
                                        ToolTipService.ToolTip="Revertir este cambio"
                                        Tag="{x:Bind}"
                                        Click="RevertChange_Click"
                                        Style="{StaticResource PremiumButtonStyle}"
                                        Padding="8,6"
                                        Visibility="{x:Bind IsReverted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE7A7;" />
                                            <TextBlock Text="Revertir" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>