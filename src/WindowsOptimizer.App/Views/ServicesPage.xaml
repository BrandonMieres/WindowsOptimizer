<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsOptimizer_App.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsOptimizer.Core.Models"
    xmlns:localmodels="using:WindowsOptimizer_App.Models"
    xmlns:viewmodels="using:WindowsOptimizer_App.ViewModels"
    xmlns:converters="using:WindowsOptimizer_App.Converters"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="36,24,36,24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Tweaks.CategoryName}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.Tweaks.StatusMessage, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.Tweaks.AvailablePresets}"
                    SelectedItem="{x:Bind ViewModel.Tweaks.SelectedPresetItem, Mode=TwoWay}"
                    MinWidth="150"
                    VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="localmodels:PresetItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="{x:Bind Icon}" />
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{x:Bind ViewModel.Tweaks.ScanCommand}" Style="{StaticResource PremiumButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                        <TextBlock Text="Escanear" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.Tweaks.ApplyAllCommand}" Style="{StaticResource PremiumAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Aplicar seleccionados" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Border Padding="12,8" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock><Run Text="{x:Bind ViewModel.Tweaks.DetectedCount, Mode=OneWay}" /><Run Text=" pendientes" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="12,8" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock><Run Text="{x:Bind ViewModel.Tweaks.AppliedCount, Mode=OneWay}" /><Run Text=" aplicados" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE930;" />
                    <TextBlock><Run Text="{x:Bind ViewModel.Tweaks.OptimalCount, Mode=OneWay}" /><Run Text=" ya óptimos" /></TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Predefined Tweaks List -->
        <Border Grid.Row="2" Margin="0,0,0,24" Style="{StaticResource PremiumCardStyle}" Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Optimizaciones Recomendadas" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tweaks.Findings, Mode=OneWay}">
                    <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Finding">
                            <Border
                                DataContext="{x:Bind}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="4"
                                BorderBrush="{x:Bind converters:SelectionConverter.GetBrush(IsSelected), Mode=OneWay}"
                                BorderThickness="2"
                                Tapped="FindingCard_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Margin="0,0,16,0" Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}, Mode=OneWay}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <Border Padding="6,2" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="4"><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Status}" /></Border>
                                        </StackPanel>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind Description}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Border>

        <!-- Custom Services Manager Dashboard -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Gestor Avanzado de Servicios" VerticalAlignment="Center" />
                <TextBox PlaceholderText="Buscar servicio..." Width="250" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{x:Bind ViewModel.LoadServicesCommand}" Style="{StaticResource PremiumButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE149;" />
                        <TextBlock Text="Recargar Lista" />
                    </StackPanel>
                </Button>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingServices, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource PremiumCardStyle}">
                <ListView ItemsSource="{x:Bind ViewModel.ServicesList, Mode=OneWay}" SelectionMode="Single" ShowsScrollingPlaceholders="False">
                    <ListView.Header>
                        <Grid Padding="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nombre" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Nombre a Mostrar" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Estado" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Inicio" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Ruta del Ejecutable" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="localmodels:WindowsServiceItem">
                            <Grid Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE904;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsMicrosoft, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" ToolTipService.ToolTip="Servicio de Microsoft" />
                                    <TextBlock Text="{x:Bind ServiceName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" HorizontalAlignment="Left" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                    <TextBlock Text="{x:Bind Status}" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{x:Bind StartType}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ExecutablePath}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Page>
