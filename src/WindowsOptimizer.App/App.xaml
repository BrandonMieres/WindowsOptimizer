<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindowsOptimizer_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsOptimizer_App"
    xmlns:converters="using:WindowsOptimizer_App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />            
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:SelectionConverter x:Key="SelectionConverter" />
            
            <!-- Premium Aesthetic Resources -->
            <ThemeShadow x:Key="SharedShadow" />
            
            <Color x:Key="SystemAccentColor">#0078D4</Color>
            
            <!-- Transitions for lists and items -->
            <TransitionCollection x:Key="ListViewTransitions">
                <AddDeleteThemeTransition />
                <ContentThemeTransition />
                <ReorderThemeTransition />
                <EntranceThemeTransition IsStaggeringEnabled="True" />
            </TransitionCollection>

            <!-- Custom Card Style -->
            <Style x:Key="PremiumCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
                <!-- Shadows are applied per element in WinUI, so we'll use a wrapper or just the style -->
            </Style>

            <Style x:Key="PremiumButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <ContentThemeTransition />
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="PremiumAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <ContentThemeTransition />
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
