<Project>

  <PropertyGroup>
    <!-- Nullable reference types habilitados en todo el proyecto -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Advertencias como errores en Release para mantener calidad -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <!-- Información de la empresa y versión -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>WindowsOptimizer Team</Authors>
    <Company>WindowsOptimizer</Company>
    <Product>Windows Optimizer</Product>
    <Copyright>Copyright © 2026 WindowsOptimizer</Copyright>

    <!-- Reproducibilidad de builds -->
    <Deterministic>true</Deterministic>

    <!-- Analizadores -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Central Package Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
